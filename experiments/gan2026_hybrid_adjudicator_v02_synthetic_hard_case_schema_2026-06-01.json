{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gan 2026 Hybrid Adjudicator V0.2 Synthetic Hard Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "failure_family",
    "source_note_text",
    "expected_final_label",
    "expected_answer_kind",
    "expected_evidence_substring",
    "deterministic_failure_rationale",
    "allowed_llm_action"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^v02_(temporal_conflict|seizure_free_boundary|unknown_no_reference_boundary|cluster_dual_axis|diary_distributed_counts|shorthand_ranges|proxy_distractor_context)_\\d{2}$"
    },
    "failure_family": {
      "type": "string",
      "enum": [
        "temporal_conflict",
        "seizure_free_boundary",
        "unknown_no_reference_boundary",
        "cluster_dual_axis",
        "diary_distributed_counts",
        "shorthand_ranges",
        "proxy_distractor_context"
      ]
    },
    "source_note_text": {
      "type": "string",
      "minLength": 40
    },
    "expected_final_label": {
      "type": "string",
      "minLength": 1
    },
    "expected_answer_kind": {
      "type": "string",
      "enum": ["frequency", "unknown", "no_reference", "seizure_free"]
    },
    "expected_evidence_substring": {
      "type": "string",
      "minLength": 1
    },
    "deterministic_failure_rationale": {
      "type": "string",
      "minLength": 10
    },
    "allowed_llm_action": {
      "type": "string",
      "enum": ["change", "flag_only", "abstain"]
    }
  }
}
