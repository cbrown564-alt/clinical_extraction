.DS_Store
Thumbs.db
Desktop.ini
~$*
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
/.tmp/
/tmp/
/.status-pytest-temp-*/
/.ci-pytest-tmp-*/
dist/
build/
*.egg-info/
node_modules/
.next/
.trace_explorer/

.worktrees/
.skills/

# Local-only research corpus, lab notebook, and derived dumps.
# Paper-facing fills live in tracked paper_experiments/.
# Frontend Demo UI mock-data stays tracked under frontend/public/mock-data/.
/data/
/docs/audio/
/experiments/
/literature/
/media/
/PROJECT_STATUS.md
/CONTEXT.md

# Scratch run scripts/outputs under scripts/ (underscore-prefixed by
# convention) and captured run logs/streams.
scripts/_*
scripts/*.stderr
scripts/*.stdout
scripts/*_stderr.txt
scripts/*_stdout.txt
logs/

# Local MLflow observability state is intentionally optional and untracked.
mlruns/
mlflow.db
mlflow.db-*

# Local operational scratch and captured run output.
scratch/*
output/

# Generated logs (LaTeX, scripts, supporting-material builds).
*.log
*.stderr.log
*.stdout.log
*.err.log
*.out.log

# LaTeX build artifacts (checked-in .tex and intentional .pdf sources remain tracked).
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.bbl
*.blg
*.toc
*.nav
*.snm
*.vrb

# SF canonical row-analysis working output (regenerable from experiments/exectv2_sf_canonical_*.py)
/_sf_canonical/
/_sf_changed_letters/

# Diagnosis canonical row-analysis working output (regenerable from experiments/exectv2_dx_canonical_*.py)
/_dx_canonical/
