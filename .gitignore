.DS_Store
Thumbs.db
Desktop.ini
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
dist/
build/
*.egg-info/

.worktrees/

# Experiment outputs can be large; keep metadata in git and add selected artifacts intentionally.
experiments/**/predictions*.csv
experiments/**/predictions*.json
experiments/**/traces/

# GEPA optimizer run scratch: cloudpickle resume checkpoints, per-example output
# dumps, and orchestrator logs/status. The curated synthesis + per-run
# json/md/jsonl/instruction artifacts are committed intentionally; these
# machine-generated internals are not.
experiments/**/gepa_state.bin
experiments/**/generated_best_outputs_valset/
experiments/gepa_overnight*/**/*.log
experiments/gepa_overnight*/*.log
experiments/gepa_overnight*/*_status.json

# Scratch run scripts/outputs under experiments/ and scripts/ (underscore-prefixed by
# convention) and captured run logs/streams. Registered artifacts are added explicitly.
experiments/_*
scripts/_*
experiments/*.log
experiments/*.stderr
experiments/*.stdout
scripts/*.log
scripts/*.stderr
scripts/*.stdout
experiments/*_stderr.txt
experiments/*_stdout.txt
scripts/*_stderr.txt
scripts/*_stdout.txt
logs/

# Local MLflow observability state is intentionally optional and untracked.
mlruns/
mlflow.db
mlflow.db-*

# Local operational scratch and captured run output (summaries belong in experiments/ or docs/).
scratch/
output/

# Run-log captures not matched by experiments/*.log (e.g. *.stderr.log suffix).
*.stderr.log
*.stdout.log
*.err.log
*.out.log
/*.log

# LaTeX build artifacts (checked-in .tex and intentional .pdf sources remain tracked).
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.bbl
*.blg
*.toc
*.nav
*.snm
*.vrb
literature/**/*.log

# SF canonical row-analysis working output (regenerable from experiments/exectv2_sf_canonical_*.py)
/_sf_canonical/
/_sf_changed_letters/

# Diagnosis canonical row-analysis working output (regenerable from experiments/exectv2_dx_canonical_*.py)
/_dx_canonical/
