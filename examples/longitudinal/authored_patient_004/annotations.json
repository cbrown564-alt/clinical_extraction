    {
      "assertion_id": "L2.pattern",
      "letter_id": "L2",
      "evidence": [
        {
          "letter_id": "L2",
          "start": 171,
          "end": 699,
          "text": "What were previously recorded in her notes as complex partial seizures correspond precisely to focal impaired-awareness seizures under contemporary classification; she had two such focal impaired-awareness seizures in April, with the latest on 22 April 2025. The historical grand mal attacks represent focal to bilateral tonic-clonic seizures, and she confirms complete freedom from bilateral tonic-clonic convulsions since 2021. This is a modernization of descriptive terminology, not a change in underlying clinical diagnosis."
        }
      ],
