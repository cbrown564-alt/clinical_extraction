{
  "$defs": {
    "Answer": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence"
        }
      },
      "required": [
        "label",
        "evidence"
      ],
      "title": "Answer",
      "type": "object"
    },
    "Bound": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bound",
          "title": "Kind",
          "type": "string"
        },
        "relation": {
          "enum": [
            "at_least",
            "more_than",
            "at_most",
            "less_than"
          ],
          "title": "Relation",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "approximate": {
          "title": "Approximate",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "relation",
        "value",
        "approximate"
      ],
      "title": "Bound",
      "type": "object"
    },
    "ClusterPattern": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cluster_pattern",
          "title": "Kind",
          "type": "string"
        },
        "cadence": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecurringRate"
            },
            {
              "type": "null"
            }
          ]
        },
        "seizures_per_cluster": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "bound": "#/$defs/Bound",
                  "exact": "#/$defs/Exact",
                  "range": "#/$defs/Range"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Exact"
                },
                {
                  "$ref": "#/$defs/Range"
                },
                {
                  "$ref": "#/$defs/Bound"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Seizures Per Cluster"
        }
      },
      "required": [
        "kind",
        "cadence",
        "seizures_per_cluster"
      ],
      "title": "ClusterPattern",
      "type": "object"
    },
    "Duration": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "discriminator": {
            "mapping": {
              "bound": "#/$defs/Bound",
              "exact": "#/$defs/Exact",
              "range": "#/$defs/Range"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Exact"
            },
            {
              "$ref": "#/$defs/Range"
            },
            {
              "$ref": "#/$defs/Bound"
            }
          ],
          "title": "Quantity"
        },
        "unit": {
          "enum": [
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "quantity",
        "unit"
      ],
      "title": "Duration",
      "type": "object"
    },
    "EventScope": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "grouping": {
          "enum": [
            "one_type",
            "explicit_combined_group",
            "unspecified"
          ],
          "title": "Grouping",
          "type": "string"
        },
        "seizure_interpretation": {
          "enum": [
            "stated_seizure",
            "uncertain_seizure",
            "explicitly_non_seizure",
            "not_specified"
          ],
          "title": "Seizure Interpretation",
          "type": "string"
        }
      },
      "required": [
        "description",
        "grouping",
        "seizure_interpretation"
      ],
      "title": "EventScope",
      "type": "object"
    },
    "Exact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "exact",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        },
        "approximate": {
          "title": "Approximate",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value",
        "approximate"
      ],
      "title": "Exact",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Finding Id",
          "type": "string"
        },
        "event": {
          "$ref": "#/$defs/EventScope"
        },
        "measurement": {
          "discriminator": {
            "mapping": {
              "cluster_pattern": "#/$defs/ClusterPattern",
              "last_seizure": "#/$defs/LastSeizure",
              "observed_count": "#/$defs/ObservedCount",
              "qualitative_frequency": "#/$defs/QualitativeFrequency",
              "recurring_rate": "#/$defs/RecurringRate",
              "seizure_free_interval": "#/$defs/SeizureFreeInterval"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/RecurringRate"
            },
            {
              "$ref": "#/$defs/ObservedCount"
            },
            {
              "$ref": "#/$defs/ClusterPattern"
            },
            {
              "$ref": "#/$defs/SeizureFreeInterval"
            },
            {
              "$ref": "#/$defs/LastSeizure"
            },
            {
              "$ref": "#/$defs/QualitativeFrequency"
            }
          ],
          "title": "Measurement"
        },
        "temporal_status": {
          "enum": [
            "current",
            "recent",
            "historical",
            "future",
            "unclear"
          ],
          "title": "Temporal Status",
          "type": "string"
        },
        "observation_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationPeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Condition"
        },
        "evidence": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "event",
        "measurement",
        "temporal_status",
        "observation_period",
        "condition",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "LastSeizure": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "last_seizure",
          "title": "Kind",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/TimePoint"
        }
      },
      "required": [
        "kind",
        "when"
      ],
      "title": "LastSeizure",
      "type": "object"
    },
    "ObservationPeriod": {
      "additionalProperties": false,
      "properties": {
        "wording": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Wording",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimePoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimePoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "wording",
        "start",
        "end",
        "duration"
      ],
      "title": "ObservationPeriod",
      "type": "object"
    },
    "ObservedCount": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "observed_count",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "discriminator": {
            "mapping": {
              "bound": "#/$defs/Bound",
              "exact": "#/$defs/Exact",
              "range": "#/$defs/Range"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Exact"
            },
            {
              "$ref": "#/$defs/Range"
            },
            {
              "$ref": "#/$defs/Bound"
            }
          ],
          "title": "Count"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationPeriod"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "count",
        "interval"
      ],
      "title": "ObservedCount",
      "type": "object"
    },
    "QualitativeFrequency": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "qualitative_frequency",
          "title": "Kind",
          "type": "string"
        },
        "wording": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Wording",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "wording"
      ],
      "title": "QualitativeFrequency",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "range",
          "title": "Kind",
          "type": "string"
        },
        "lower": {
          "minimum": 0,
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "title": "Upper",
          "type": "number"
        },
        "approximate": {
          "title": "Approximate",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "lower",
        "upper",
        "approximate"
      ],
      "title": "Range",
      "type": "object"
    },
    "RecurringRate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recurring_rate",
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "discriminator": {
            "mapping": {
              "bound": "#/$defs/Bound",
              "exact": "#/$defs/Exact",
              "range": "#/$defs/Range"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Exact"
            },
            {
              "$ref": "#/$defs/Range"
            },
            {
              "$ref": "#/$defs/Bound"
            }
          ],
          "title": "Count"
        },
        "denominator": {
          "$ref": "#/$defs/Duration"
        }
      },
      "required": [
        "kind",
        "count",
        "denominator"
      ],
      "title": "RecurringRate",
      "type": "object"
    },
    "SeizureFreeInterval": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "seizure_free_interval",
          "title": "Kind",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimePoint"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "duration",
        "since"
      ],
      "title": "SeizureFreeInterval",
      "type": "object"
    },
    "TimePoint": {
      "additionalProperties": false,
      "properties": {
        "wording": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Wording",
          "type": "string"
        },
        "form": {
          "enum": [
            "calendar",
            "relative"
          ],
          "title": "Form",
          "type": "string"
        },
        "precision": {
          "enum": [
            "day",
            "month",
            "year",
            "unspecified"
          ],
          "title": "Precision",
          "type": "string"
        }
      },
      "required": [
        "wording",
        "form",
        "precision"
      ],
      "title": "TimePoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "$ref": "#/$defs/Answer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "selected_finding_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Selected Finding Ids",
      "type": "array"
    }
  },
  "required": [
    "answer",
    "findings",
    "selected_finding_ids"
  ],
  "title": "Rich",
  "type": "object"
}
