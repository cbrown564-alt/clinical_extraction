{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinical-extraction.local/gan2026/compact-scope-candidate/rich.schema.json",
  "title": "Compact seizure-activity claim candidate",
  "description": "Development-only shape. The candidate guide owns clinical inclusion and scoring; this schema does not validate source entailment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "findings"],
  "properties": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence", "claim_indices"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "evidence": {"type": ["string", "null"]},
        "claim_indices": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "quantity": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "number"}, "value": {"type": "integer", "minimum": 0}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "lower", "upper"],
          "properties": {
            "kind": {"const": "range"},
            "lower": {"type": "integer", "minimum": 0},
            "upper": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "relation", "value"],
          "properties": {
            "kind": {"const": "bound"},
            "relation": {"enum": ["at_least", "more_than", "at_most", "less_than"]},
            "value": {
              "oneOf": [
                {"type": "integer", "minimum": 0},
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["kind", "lower", "upper"],
                  "properties": {
                    "kind": {"const": "range"},
                    "lower": {"type": "integer", "minimum": 0},
                    "upper": {"type": "integer", "minimum": 0}
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {"kind": {"const": "verbatim"}, "text": {"$ref": "#/$defs/nonblank"}}
        }
      ]
    },
    "duration": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value", "unit"],
          "properties": {
            "kind": {"const": "number"},
            "value": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"enum": ["second", "minute", "hour", "day", "week", "month", "quarter", "year"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "lower", "upper", "unit"],
          "properties": {
            "kind": {"const": "range"},
            "lower": {"type": "number", "exclusiveMinimum": 0},
            "upper": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"enum": ["second", "minute", "hour", "day", "week", "month", "quarter", "year"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "relation", "value", "unit"],
          "properties": {
            "kind": {"const": "bound"},
            "relation": {"enum": ["at_least", "more_than", "at_most", "less_than"]},
            "value": {"type": "number", "exclusiveMinimum": 0},
            "unit": {"enum": ["second", "minute", "hour", "day", "week", "month", "quarter", "year"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {"kind": {"const": "verbatim"}, "text": {"$ref": "#/$defs/nonblank"}}
        }
      ]
    },
    "rate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "quantity", "per"],
      "properties": {
        "kind": {"const": "rate"},
        "quantity": {"$ref": "#/$defs/quantity"},
        "per": {"$ref": "#/$defs/duration"}
      }
    },
    "observed_count": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "quantity"],
      "properties": {"kind": {"const": "observed_count"}, "quantity": {"$ref": "#/$defs/quantity"}}
    },
    "cluster": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "anyOf": [
        {"required": ["count"]},
        {"required": ["cadence"]},
        {"required": ["seizures_per_cluster"]}
      ],
      "properties": {
        "kind": {"const": "cluster"},
        "count": {"$ref": "#/$defs/quantity"},
        "cadence": {"$ref": "#/$defs/rate"},
        "seizures_per_cluster": {"$ref": "#/$defs/quantity"}
      }
    },
    "seizure_free": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "anyOf": [{"required": ["duration"]}, {"required": ["since"]}],
      "properties": {
        "kind": {"const": "seizure_free"},
        "duration": {"$ref": "#/$defs/duration"},
        "since": {"$ref": "#/$defs/nonblank"}
      }
    },
    "last_event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "occurred_at"],
      "properties": {
        "kind": {"const": "last_event"},
        "occurred_at": {"$ref": "#/$defs/nonblank"}
      }
    },
    "qualitative": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "level"],
      "properties": {
        "kind": {"const": "qualitative"},
        "level": {"enum": ["occasional", "frequent"]}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["event", "counted_unit", "status", "measurement", "time", "evidence"],
      "allOf": [
        {
          "if": {"properties": {"measurement": {"properties": {"kind": {"enum": ["seizure_free", "last_event"]}}}}},
          "then": {"properties": {"counted_unit": {"const": "not_applicable"}}}
        },
        {
          "if": {"properties": {"measurement": {"properties": {"kind": {"const": "cluster"}}}}},
          "then": {"properties": {"counted_unit": {"enum": ["cluster", "cluster_day"]}}}
        },
        {
          "if": {"properties": {"measurement": {"properties": {"kind": {"enum": ["rate", "observed_count"]}}}}},
          "then": {"properties": {"counted_unit": {"enum": ["individual_seizure", "seizure_day", "seizure_night"]}}}
        },
        {
          "if": {"properties": {"measurement": {"properties": {"kind": {"const": "observed_count"}}}}},
          "then": {"properties": {"time": {"required": ["source"]}}}
        },
        {
          "if": {"properties": {"measurement": {"required": ["count"], "properties": {"kind": {"const": "cluster"}}}}},
          "then": {"properties": {"time": {"required": ["source"]}}}
        }
      ],
      "properties": {
        "event": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "label"],
          "properties": {
            "scope": {"enum": ["overall", "named", "combined", "unspecified"]},
            "label": {"$ref": "#/$defs/nonblank"}
          }
        },
        "counted_unit": {"enum": ["individual_seizure", "seizure_day", "seizure_night", "cluster", "cluster_day", "not_applicable"]},
        "status": {"enum": ["stated", "uncertain"]},
        "measurement": {
          "oneOf": [
            {"$ref": "#/$defs/rate"},
            {"$ref": "#/$defs/observed_count"},
            {"$ref": "#/$defs/cluster"},
            {"$ref": "#/$defs/seizure_free"},
            {"$ref": "#/$defs/last_event"},
            {"$ref": "#/$defs/qualitative"}
          ]
        },
        "time": {
          "type": "object", "additionalProperties": false,
          "required": ["phase"],
          "properties": {
            "source": {"$ref": "#/$defs/nonblank"},
            "phase": {"enum": ["ongoing", "superseded", "past_or_unclear"]}
          }
        },
        "restriction": {"$ref": "#/$defs/nonblank"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank"}}
      }
    }
  }
}
